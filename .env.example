# =============================================================================
# JOB-AI CAREER BUDDY — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and configure your desired parameters.
# NEVER commit your real .env file or credentials to version control.
# =============================================================================

# General Settings
JOB_AI_DATABASE_URL=sqlite:///data/job_ai.db
JOB_AI_DASHBOARD_URL=http://localhost:8501

# Continuous Monitor & Freshness Settings
JOB_AI_SCAN_INTERVAL_MINUTES=60
JOB_AI_SCAN_WINDOW_HOURS=24.0

# Email Notification Automation
JOB_AI_EMAIL_ENABLED=false
JOB_AI_EMAIL_PROVIDER=console       # Options: console, smtp, mock
JOB_AI_EMAIL_FROM=alerts@job-ai.local
JOB_AI_EMAIL_TO=candidate@vlsi-career.internal

# SMTP Settings (Required only when JOB_AI_EMAIL_PROVIDER=smtp)
JOB_AI_EMAIL_SMTP_HOST=smtp.gmail.com
JOB_AI_EMAIL_SMTP_PORT=587
JOB_AI_EMAIL_USERNAME=
JOB_AI_EMAIL_PASSWORD=
JOB_AI_EMAIL_USE_TLS=true
JOB_AI_EMAIL_TIMEOUT_SECONDS=30
JOB_AI_EMAIL_MAX_RETRIES=3

# Daily Career Intelligence Digest
JOB_AI_DIGEST_ENABLED=true
JOB_AI_DIGEST_HOUR=19               # 7:00 PM local time
